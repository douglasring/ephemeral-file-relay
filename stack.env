# Copy this file to .env (or set the same vars in the Portainer stack UI).
# Generate a strong token:  openssl rand -hex 32
UPLOAD_TOKEN=replace-with-output-of-openssl-rand-hex-32

# How long a file stays in RAM before auto-delete (seconds). 600 = 10 minutes.
TTL_SECONDS=600

# Max upload size in MB. Base44 statements are PDFs up to ~10MB; 15 is headroom.
MAX_FILE_MB=15

# Max files held in RAM at once.
MAX_ENTRIES=500

# The PUBLIC https URL of this relay (from your Cloudflare Tunnel in Step 4).
# Uploads return URLs shaped like  ${PUBLIC_BASE}/f/<id>
PUBLIC_BASE=https://relay.example.com
